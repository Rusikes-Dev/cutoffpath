# ---------------------------------------------------------------------------
# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit the real values.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # service_role, NOT anon

# Razorpay → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Price in paise. 4900 = Rs 49
PRICE_PAISE=4900

# Admin panel at /admin
ADMIN_PASSWORD=pick-something-long-and-random
ADMIN_SECRET=another-long-random-string-for-signing-sessions
